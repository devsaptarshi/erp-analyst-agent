# Local dev Postgres (docker compose up -d), NOT the analyst_ro role —
# this one has DDL rights, used by migrations/seeding/admin scripts.
DATABASE_URL=postgresql://erp_admin:dev-only-local-password@127.0.0.1:5433/erp_analyst

# The agent's own connection: read-only role, RLS-enforced. Set up by
# scripts/init_db.py (CREATE ROLE analyst_ro ... NOSUPERUSER NOBYPASSRLS).
ANALYST_DATABASE_URL=postgresql://analyst_ro:dev-only-local-password@127.0.0.1:5433/erp_analyst

# Model provider — see src/erp_analyst/agent/models.py for the cheap/strong tiers.
ANTHROPIC_API_KEY=

# "cheap" vs "strong" model ids (see build spec: escalate only on repair failure).
ERP_MODEL_CHEAP=claude-haiku-5-5
ERP_MODEL_STRONG=claude-sonnet-5-5

# Statement timeout enforced both in Postgres (RLS session) and the app layer.
ANALYST_STATEMENT_TIMEOUT_MS=5000
